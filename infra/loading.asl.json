{
  "StartAt": "Work",
  "TimeoutSeconds": 7200,
  "States": {
    "Work": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Create",
          "States": {
            "Create": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${worker_arn}",
                "Payload": {
                  "action": "create",
                  "version_id.$": "$.version_id",
                  "owner.$": "$.owner"
                }
              },
              "ResultSelector": {
                "value.$": "$.Payload"
              },
              "ResultPath": "$.result",
              "TimeoutSeconds": 900,
              "Next": "Wait"
            },
            "Wait": {
              "Type": "Wait",
              "Seconds": 30,
              "Next": "Poll"
            },
            "Poll": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${worker_arn}",
                "Payload": {
                  "action": "poll",
                  "version_id.$": "$.version_id",
                  "owner.$": "$.owner"
                }
              },
              "ResultSelector": {
                "value.$": "$.Payload"
              },
              "ResultPath": "$.result",
              "TimeoutSeconds": 900,
              "Next": "Status"
            },
            "Status": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.result.value.status",
                  "StringEquals": "Completed",
                  "Next": "Warm"
                },
                {
                  "Variable": "$.result.value.status",
                  "StringEquals": "Failed",
                  "Next": "Failed"
                }
              ],
              "Default": "Wait"
            },
            "Warm": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${worker_arn}",
                "Payload": {
                  "action": "warm",
                  "version_id.$": "$.version_id",
                  "owner.$": "$.owner"
                }
              },
              "ResultSelector": {
                "value.$": "$.Payload"
              },
              "ResultPath": "$.result",
              "TimeoutSeconds": 900,
              "Next": "Done",
              "Catch": [
                {
                  "ErrorEquals": [
                    "ModelWarming"
                  ],
                  "ResultPath": "$.warm_error",
                  "Next": "Reimport"
                }
              ]
            },
            "Reimport": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${worker_arn}",
                "Payload": {
                  "action": "reimport",
                  "version_id.$": "$.version_id",
                  "owner.$": "$.owner"
                }
              },
              "ResultSelector": {
                "value.$": "$.Payload"
              },
              "ResultPath": "$.result",
              "TimeoutSeconds": 900,
              "Next": "ReimportStatus"
            },
            "ReimportStatus": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.result.value.complete",
                  "BooleanEquals": true,
                  "Next": "Create"
                }
              ],
              "Default": "WaitDelete"
            },
            "WaitDelete": {
              "Type": "Wait",
              "Seconds": 30,
              "Next": "Reimport"
            },
            "Done": {
              "Type": "Succeed"
            },
            "Failed": {
              "Type": "Fail",
              "Error": "ImportFailed"
            }
          }
        }
      ],
      "ResultPath": null,
      "Next": "Finish",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Cleanup"
        }
      ]
    },
    "Finish": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${worker_arn}",
        "Payload": {
          "action": "finish",
          "version_id.$": "$.version_id",
          "owner.$": "$.owner"
        }
      },
      "ResultSelector": {
        "value.$": "$.Payload"
      },
      "ResultPath": "$.result",
      "TimeoutSeconds": 900,
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    },
    "Cleanup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${worker_arn}",
        "Payload": {
          "action": "fail",
          "version_id.$": "$.version_id",
          "owner.$": "$.owner"
        }
      },
      "ResultSelector": {
        "value.$": "$.Payload"
      },
      "ResultPath": "$.result",
      "TimeoutSeconds": 900,
      "Next": "CleanupStatus"
    },
    "CleanupStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.value.complete",
          "BooleanEquals": true,
          "Next": "Failed"
        }
      ],
      "Default": "WaitCleanup"
    },
    "WaitCleanup": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "Cleanup"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "VersionLoadFailed"
    }
  }
}
